CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_16=y  
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"


CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# LVGL Memory Configuration
CONFIG_LV_MEM_SIZE_KILOBYTES=104

# CPU Frequency - 80MHz for maximum power saving (default is 240MHz)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# Keep ADC on during touch reads; display.c powers down afterward to rearm PENIRQ.
CONFIG_XPT2046_INTERRUPT_MODE=n

# The display owns a no-light-sleep lock until its 60-second idle timeout.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
# CONFIG_PM_DFS_INIT_AUTO is not set
# CONFIG_PM_PROFILING is not set
# CONFIG_PM_SLP_DISABLE_GPIO is not set
# CONFIG_ESP_SLEEP_POWER_DOWN_FLASH is not set

# New OTA images must confirm successful startup before remaining selected.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
